    {
      "id": 4,
      "audio": "static/audio/narration/04_relational_alignment.mp3",
      "duration": 27.936,
      "sha256": "97be60921159b36c317f632d2f0cc450e3c5a8bf33e76d05b7f09322805a2808",
      "stage": 2,
      "lifting": "ordinal",
      "sentences": [
        {
          "id": "04.01",
          "text": "The core of D-JEPA is relational alignment.",
          "start": 0,
          "end": 2.32
        },
        {
          "id": "04.02",
          "text": "Each candidate attends to the full set, gathering evidence from the alternatives it competes against.",
          "start": 3.34,
          "end": 8.5
        },
        {
          "id": "04.03",
          "text": "We train these relations using executed candidate outcomes, with particular emphasis on the distinctions that determine action selection.",
          "start": 9.12,
          "end": 16.46
        },
        {
          "id": "04.04",
          "text": "Watch the weighted messages gather into a candidate-specific context.",
          "start": 17.52,
          "end": 20.98
        },
        {
          "id": "04.05",
          "text": "A shared correction head turns that context into a bounded adjustment to the predictive ordering.",
          "start": 22.26,
          "end": 26.8
        }
      ],
      "keyframes": [
