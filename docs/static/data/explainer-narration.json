    {
      "id": 6,
      "audio": "static/audio/narration/06_ordinal_realization.mp3",
      "duration": 25.92,
      "sha256": "2fca0425fe10d0cb280532a6169ab620b45de53fd749b10a497a363498d36911",
      "stage": 4,
      "lifting": "ordinal",
      "sentences": [
        {
          "id": "06.01",
          "text": "Next, we write the learned ordering directly into future representations.",
          "start": 0,
          "end": 3.5
        },
        {
          "id": "06.02",
          "text": "First, read the aligned rank.",
          "start": 5.3,
          "end": 6.62
        },
        {
          "id": "06.03",
          "text": "Then convert that rank into a target distance from the goal.",
          "start": 7.72,
          "end": 10.4
        },
        {
          "id": "06.04",
          "text": "Move the terminal future to that distance, keeping its direction and earlier future steps unchanged.",
          "start": 11.48,
          "end": 16.4
        },
        {
          "id": "06.05",
          "text": "Now watch the native-distance readout: the nearest future recovers the aligned choice, and the complete ordering follows automatically.",
          "start": 17.88,
          "end": 24.52
        }
      ],
