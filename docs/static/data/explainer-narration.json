    {
      "id": 3,
      "audio": "static/audio/narration/03_predictive_evidence.mp3",
      "duration": 24.072,
      "sha256": "84d1b66f9e7a8e135a75c1a3a1f0a291ec72576fc6d641ace16c04558b64b1a2",
      "stage": 1,
      "lifting": "ordinal",
      "sentences": [
        {
          "id": "03.01",
          "text": "D-JEPA starts with the futures already predicted for each candidate action.",
          "start": 0,
          "end": 3.82
        },
        {
          "id": "03.02",
          "text": "We describe each future relative to its goal, while keeping detailed features inside their original predictive space.",
          "start": 4.92,
          "end": 10.88
        },
        {
          "id": "03.03",
          "text": "We also convert model preferences into ranks, providing a shared comparison scale.",
          "start": 11.68,
          "end": 16.78
        },
        {
          "id": "03.04",
          "text": "This lets complementary predictive geometries contribute evidence to a common candidate representation.",
          "start": 17.86,
          "end": 22.58
        }
      ],
      "architecture": [
