    {
      "id": 8,
      "audio": "static/audio/narration/08_validation.mp3",
      "duration": 30.48,
      "sha256": "063b3aef3555afdfa8eae9b377864d2b6f66601bc8393d685b05a3d327ba210f",
      "stage": 5,
      "lifting": "ordinal",
      "sentences": [
        {
          "id": "08.01",
          "text": "Finally, the selected action is executed.",
          "start": 0,
          "end": 2.24
        },
        {
          "id": "08.02",
          "text": "The same starting state can now lead to a different physical future.",
          "start": 3.58,
          "end": 6.78
        },
        {
          "id": "08.03",
          "text": "Our evaluations span pushing, reaching, granular manipulation, bimanual tasks, physical robots, and autonomous driving.",
          "start": 7.88,
          "end": 16.06
        },
        {
          "id": "08.04",
          "text": "Success improves by about fifteen percentage points on RoboTwin and seventeen on physical robot tasks.",
          "start": 17.2,
          "end": 22.94
        },
        {
          "id": "08.05",
          "text": "D-JEPA connects predictive world modeling to control by learning the relations that make better decisions.",
          "start": 24.16,
          "end": 29.24
        }
      ],
