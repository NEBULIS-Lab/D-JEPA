    {
      "id": 7,
      "audio": "static/audio/narration/07_temporal_transport.mp3",
      "duration": 20.904,
      "sha256": "0f93fa76605f34261e938c77d8a49f6bf85c4320e619953946e01994a0a94886",
      "stage": 4,
      "lifting": "transport",
      "sentences": [
        {
          "id": "07.01",
          "text": "Our Reacher representation study explores a complementary route: bounded temporal transport.",
          "start": 0,
          "end": 5.1
        },
        {
          "id": "07.02",
          "text": "Here, learned residuals refine five corresponding future steps while preserving action identity.",
          "start": 5.86,
          "end": 11.36
        },
        {
          "id": "07.03",
          "text": "The two mechanisms study how decision structure can be expressed through future latents, from exact ordinal geometry to learned temporal updates.",
          "start": 12.46,
          "end": 19.64
        }
      ],
      "architecture": [
