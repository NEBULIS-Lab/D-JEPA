    {
      "id": 1,
      "audio": "static/audio/narration/01_question.mp3",
      "duration": 21.768,
      "sha256": "aecddd5c7e931848bbdcadb75e32a0c6dc1b1a6b9ac1ef0b5a2dd317b714e0ae",
      "stage": 0,
      "lifting": "ordinal",
      "sentences": [
        {
          "id": "01.01",
          "text": "Predicting a plausible future is only part of the problem.",
          "start": 0,
          "end": 2.9
        },
        {
          "id": "01.02",
          "text": "A controller must choose which future to pursue.",
          "start": 3.9,
          "end": 6.24
        },
        {
          "id": "01.03",
          "text": "D-JEPA is a decision-aligned latent world model built on pretrained predictive models.",
          "start": 7.38,
          "end": 11.82
        },
        {
          "id": "01.04",
          "text": "Our starting point is simple: two predicted futures can have almost identical distances to the goal, yet lead to very different physical outcomes.",
          "start": 13.06,
          "end": 20.5
        }
      ],
      "keyframes": [
        {
          "time": 0,
          "elapsed": 0,
          "sources": 2,
          "predictor": false
