    {
      "id": 2,
      "audio": "static/audio/narration/02_prediction_gap.mp3",
      "duration": 26.832,
      "sha256": "aebab83444db3edf1ae0d95ec5eb359381a388ea57db0fcc4d3709dfb6af9f8e",
      "stage": 0,
      "lifting": "ordinal",
      "sentences": [
        {
          "id": "02.01",
          "text": "Watch these two actions from the same initial state.",
          "start": 0,
          "end": 2.72
        },
        {
          "id": "02.02",
          "text": "The closer predicted future fails, while the slightly farther one succeeds.",
          "start": 3.76,
          "end": 7.62
        },
        {
          "id": "02.03",
          "text": "This reflects a broader decision-local prediction gap.",
          "start": 8.86,
          "end": 11.66
        },
        {
          "id": "02.04",
          "text": "For LeWM, ranking correlation falls from point nine zero across all sixty-three candidates to point one one among the top four.",
          "start": 12.7,
          "end": 20.2
        },
        {
          "id": "02.05",
          "text": "Predictive geometry becomes least reliable precisely where the next action is selected.",
          "start": 21.0,
          "end": 25.68
        }
      ],
      "keyframes": [
        {
          "time": 0,
          "elapsed": 4,
