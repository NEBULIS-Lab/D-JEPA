    {
      "id": 5,
      "audio": "static/audio/narration/05_decision_rule.mp3",
      "duration": 28.584,
      "sha256": "eae01c476013b9ee492f6fe9c1191e50b47ecc92ae1e3c819a5bed498f26f535",
      "stage": 3,
      "lifting": "ordinal",
      "sentences": [
        {
          "id": "05.01",
          "text": "These adjustments concentrate on close alternatives near the decision boundary.",
          "start": 0,
          "end": 3.74
        },
        {
          "id": "05.02",
          "text": "As the scores change, the preferred action can change with them.",
          "start": 4.96,
          "end": 8.34
        },
        {
          "id": "05.03",
          "text": "A calibrated margin gate determines when to adopt the aligned choice.",
          "start": 9.38,
          "end": 12.76
        },
        {
          "id": "05.04",
          "text": "Restricted adaptation of the final predictor block and projection can also contribute a complementary proposal.",
          "start": 13.86,
          "end": 19.56
        },
        {
          "id": "05.05",
          "text": "Relational alignment remains the core decision rule, with adaptation and additional predictive geometries extending its evidence.",
          "start": 20.62,
          "end": 27.38
        }
      ],
      "architecture": [
